# Скопировать: cp frontend/.env.development.example frontend/.env.development
# Имя бота без @ — то же значение, что TG_BOT_USERNAME в корневом .env
VITE_TG_BOT_USERNAME=
# Прокси Vite dev server → API (по умолчанию http://localhost:8000)
# VITE_BACKEND_TARGET=http://localhost:8000
# Preconnect в index.html (только если API на другом origin)
# VITE_API_ORIGIN=https://api.example.com
