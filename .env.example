# Core
APP_ENV=dev
POSTGRES_USER=shopstore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopstore
DATABASE_URL=postgresql+asyncpg://shopstore:change-me@db:5432/shopstore
ALEMBIC_DATABASE_URL=postgresql+psycopg2://shopstore:change-me@db:5432/shopstore
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_BACKEND=local
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=shopstore-media
S3_REGION=us-east-1

# Auth
AUTH_SECRET=change-me-to-random-64-hex-chars
ACCESS_TOKEN_TTL_SECONDS=86400
TG_LOGIN_MAX_AGE_SECONDS=3600
ADMIN_TG_IDS=
ADMIN_PANEL_LOGIN=admin
ADMIN_PANEL_PASSWORD=change-me-strong-password
PHONE_AUTH_ENABLED=false

# Telegram
TG_ADMIN_ID=0
TG_BOT_SHOP=
TG_BOT_USERNAME=
TG_MINI_APP_URL=
TG_ORDERS_CHAT_ID=0
TG_SUPPORT_CHAT_ID=0

# SBP
SBP_ENABLED=false
SBP_AUTH_BASE_URL=https://auth.example.com/api/v1
SBP_API_BASE_URL=https://payments.example.com/api/v1
SBP_LOGIN=
SBP_PASSWORD=
SBP_TSP_ID=0
SBP_CALLBACK_URL=https://example.com/payments/sbp/callback
SBP_WEBHOOK_PUBLIC_KEY=
SBP_SKIP_SIGNATURE_VERIFY=false
SBP_TEST_MODE=true
SBP_TIMEOUT_SECONDS=15
SBP_MIN_PAYMENT_AMOUNT_MINOR=100
SBP_MAX_PAYMENT_AMOUNT_MINOR=1000000

# Workers and cache
CATALOG_IMPORT_QUEUE=catalog_import
TRANSLATION_QUEUE=translation
WORKER_TRANSLATION_SCALE=1
PRICING_QUEUE=pricing
PRICING_BATCH_SIZE=1000
WORKER_IMPORT_SCALE=1
WORKER_DOM_LANE_1_SCALE=1
WORKER_DOM_LANE_2_SCALE=1
REDIS_HEALTH_ALERT_SECONDS=60
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
CATALOG_FACETS_CACHE_TTL_SECONDS=120
PHONE_VERIFICATION_CODE_ENABLED=false
